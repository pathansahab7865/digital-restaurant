rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username → ईमेल की मैपिंग (Sign In के लिए ज़रूरी) — कोई भी पढ़ सकता है (सिर्फ लुकअप के लिए),
    // पर सिर्फ अपने लिए ही नया username बना सकता है, किसी और के लिए नहीं, और बदल/मिटा नहीं सकता
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /restaurants/{restaurantId} {
      // कोई भी (बिना लॉगिन के भी) रेस्टोरेंट प्रोफाइल पढ़ सकता है — कस्टमर के मेन्यू पेज के लिए ज़रूरी है
      allow read: if true;
      // सिर्फ वही ओनर अपनी प्रोफाइल में बदलाव कर सकता है, या एडमिन (नीचे अपना असली ईमेल डालें)
      allow write: if request.auth != null && (
        request.auth.uid == restaurantId ||
        request.auth.token.email == "yourname@gmail.com"
      );

      match /menuItems/{itemId} {
        // कोई भी मेन्यू आइटम पढ़ सकता है — कस्टमर मेन्यू देखने के लिए ज़रूरी है
        allow read: if true;
        // सिर्फ उस रेस्टोरेंट का ओनर ही अपने मेन्यू में आइटम जोड़/हटा/बदल सकता है
        allow write: if request.auth != null && request.auth.uid == restaurantId;
      }

      match /orders/{orderId} {
        // कोई भी कस्टमर (बिना लॉगिन के भी) नया ऑर्डर बना सकता है
        allow create: if true;
        // सिर्फ रेस्टोरेंट का ओनर ही ऑर्डर पढ़/अपडेट/डिलीट कर सकता है (दूसरे कस्टमर का ऑर्डर कोई और नहीं देख सकता)
        allow read, update, delete: if request.auth != null && request.auth.uid == restaurantId;
      }
    }
  }
}
